/* ================= ESTADO ================= */
let CANDIDATOS = {};
let numero = "";
let bloqueado = false;   // trava durante confirmação / fim

/* ================= INICIALIZAÇÃO ================= */
document.addEventListener("DOMContentLoaded", async () => {
  const r = await fetch("/api/candidatos");
  const d = await r.json();
  if (d.ok) {
    d.candidatos.forEach(c => CANDIDATOS[c.numero] = c);
  }
  atualizar();
  ligarTeclado();
});

/* ================= TECLADO ================= */
function ligarTeclado() {
  document.querySelectorAll(".tecla.num").forEach(btn => {
    btn.addEventListener("click", () => {
      if (bloqueado) return;
      digitar(btn.dataset.n);
    });
  });

  document.getElementById("btn-branco").addEventListener("click", () => {
    if (bloqueado) return;
    votoBranco();
  });
  document.getElementById("btn-corrige").addEventListener("click", () => {
    if (bloqueado) return;
    corrigir();
  });
  document.getElementById("btn-confirma").addEventListener("click", () => {
    if (bloqueado) return;
    confirmar();
  });

  // Suporte a teclado físico
  document.addEventListener("keydown", (e) => {
    if (bloqueado) return;
    if (/^[0-9]$/.test(e.key)) digitar(e.key);
    else if (e.key === "Backspace") corrigir();
    else if (e.key === "Enter") confirmar();
    else if (e.key === "b" || e.key === "B") votoBranco();
  });
}

/* ================= AÇÕES ================= */
function digitar(n) {
  if (numero.length < 2) {
    numero += n;
    atualizar();
  }
}

function corrigir() {
  numero = "";
  atualizar();
  setMsg("Aperte a tecla verde <b>CONFIRMA</b> para confirmar<br>ou <b>BRANCO</b> para votar em branco");
}

function atualizar() {
  // Dígitos
  const digEls = document.querySelectorAll("#numero .dig");
  const chars = numero.padEnd(2, " ").split("");
  digEls.forEach((el, i) => {
    const ch = chars[i].trim();
    el.textContent = ch || "";
    el.classList.toggle("preenchido", !!ch);
  });

  // Informações
  const nomeEl = document.getElementById("info-nome");
  const chapaEl = document.getElementById("info-chapa");
  const viceEl = document.getElementById("info-vice");
  const msg = document.getElementById("msg-central");

  if (CANDIDATOS[numero]) {
    const c = CANDIDATOS[numero];
    nomeEl.textContent = c.nome;
    chapaEl.textContent = c.chapa;
    viceEl.textContent = c.vice;
    msg.classList.remove("alerta");
    setMsg("Aperte a tecla verde <b>CONFIRMA</b> para confirmar");
  } else if (numero.length === 2) {
    nomeEl.textContent = "—";
    chapaEl.textContent = "—";
    viceEl.textContent = "—";
    msg.classList.add("alerta");
    setMsg("NÚMERO ERRADO<br>Aperte <b>CORRIGE</b> para digitar novamente");
  } else {
    nomeEl.textContent = "—";
    chapaEl.textContent = "—";
    viceEl.textContent = "—";
    msg.classList.remove("alerta");
    setMsg("Aperte a tecla verde <b>CONFIRMA</b> para confirmar<br>ou <b>BRANCO</b> para votar em branco");
  }
}

function setMsg(html) {
  document.getElementById("msg-central").innerHTML = html;
}

/* ================= VOTAR ================= */
async function votoBranco() {
  if (!confirm("Confirmar voto em BRANCO?")) return;
  await enviar({tipo: "branco"});
}

async function confirmar() {
  if (numero.length < 2) {
    alert("Digite os 2 dígitos do candidato ou pressione BRANCO.");
    return;
  }
  if (CANDIDATOS[numero]) {
    const c = CANDIDATOS[numero];
    if (!confirm(`Confirmar voto em:\n\n${c.nome}\nChapa: ${c.chapa}\nVice: ${c.vice}`)) return;
    await enviar({tipo: "valido", numero: numero});
  } else {
    if (!confirm("Número inexistente.\n\nConfirmar como VOTO NULO?")) return;
    await enviar({tipo: "nulo", numero: numero});
  }
}

async function enviar(payload) {
  bloqueado = true;
  try {
    const r = await fetch("/api/votar", {
      method: "POST",
      headers: {"Content-Type": "application/json"},
      body: JSON.stringify(payload)
    });
    const d = await r.json();
    if (!d.ok) {
      alert(d.msg || "Erro ao registrar o voto.");
      bloqueado = false;
      return;
    }
    mostrarFim(d);
  } catch (e) {
    alert("Erro de comunicação com o servidor.");
    bloqueado = false;
  }
}

/* ================= FIM ================= */
function mostrarFim(d) {
  document.getElementById("fim-overlay").style.display = "flex";
  let msg = "";
  if (d.tipo === "valido") msg = `Voto confirmado em <b>${d.nome}</b>`;
  else if (d.tipo === "branco") msg = "Voto em <b>BRANCO</b> registrado";
  else msg = "Voto <b>NULO</b> registrado";
  document.getElementById("fim-msg").innerHTML = msg;

  // Fecha automaticamente após 5s
  setTimeout(() => {
    fetch("/api/logout", {method:"POST"}).finally(() => window.location.href = "/");
  }, 5000);
}
