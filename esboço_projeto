from flask import Flask, render_template, request, jsonify, session, redirect
from functools import wraps
import database as db

app = Flask(__name__)
app.secret_key = "troque-esta-chave-em-producao"

SENHA_ADMIN = "admin123"

db.init_db()

# ================= PÁGINAS =================
@app.route("/")
def index():
    return render_template("login.html")

@app.route("/urna")
def urna():
    if "matricula" not in session:
        return redirect("/")
    if db.eleicao_encerrada():
        session.clear()
        return render_template("login.html", erro="A votação foi encerrada.")
    return render_template("urna.html")

@app.route("/admin")
def admin():
    return render_template("admin.html")

# ================= API ELEITOR =================
@app.route("/api/login", methods=["POST"])
def api_login():
    d = request.get_json() or {}
    matricula = (d.get("matricula") or "").strip()

    if not matricula:
        return jsonify({"ok": False, "msg": "Informe a matrícula."}), 400
    if db.eleicao_encerrada():
        return jsonify({"ok": False, "msg": "A votação foi encerrada."}), 403

    aluno = db.buscar_aluno(matricula)
    if not aluno:
        return jsonify({"ok": False, "msg": "Matrícula não encontrada."}), 404
    if aluno["ja_votou"]:
        return jsonify({"ok": False, "msg": "Esta matrícula já votou."}), 403

    session["matricula"] = matricula
    session["nome"] = aluno["nome"]
    return jsonify({"ok": True, "nome": aluno["nome"], "turma": aluno["turma"]})

@app.route("/api/candidatos")
def api_candidatos():
    if "matricula" not in session:
        return jsonify({"ok": False, "msg": "Não autenticado."}), 401
    cands = db.listar_candidatos()
    return jsonify({"ok": True, "candidatos": [
        {"numero": c["numero"], "nome": c["nome"],
         "chapa": c["chapa"], "vice": c["vice"]} for c in cands
    ]})

@app.route("/api/votar", methods=["POST"])
def api_votar():
    if "matricula" not in session:
        return jsonify({"ok": False, "msg": "Sessão expirada."}), 401

    matricula = session["matricula"]
    aluno = db.buscar_aluno(matricula)
    if not aluno:
        return jsonify({"ok": False, "msg": "Aluno inválido."}), 404
    if aluno["ja_votou"]:
        return jsonify({"ok": False, "msg": "Você já votou."}), 403
    if db.eleicao_encerrada():
        return jsonify({"ok": False, "msg": "Votação encerrada."}), 403

    d = request.get_json() or {}
    tipo = d.get("tipo")
    numero = d.get("numero")

    if tipo not in ("valido", "branco", "nulo"):
        return jsonify({"ok": False, "msg": "Tipo inválido."}), 400

    if tipo == "valido":
        cands = {c["numero"] for c in db.listar_candidatos()}
        if numero not in cands:
            return jsonify({"ok": False, "msg": "Número inválido."}), 400
        db.registrar_voto(matricula, numero, "valido")
        nome = next(c["nome"] for c in db.listar_candidatos() if c["numero"] == numero)
        session.pop("matricula", None)
        return jsonify({"ok": True, "tipo": "valido", "nome": nome})

    if tipo == "branco":
        db.registrar_voto(matricula, None, "branco")
        session.pop("matricula", None)
        return jsonify({"ok": True, "tipo": "branco"})

    db.registrar_voto(matricula, numero or "00", "nulo")
    session.pop("matricula", None)
    return jsonify({"ok": True, "tipo": "nulo"})

@app.route("/api/logout", methods=["POST"])
def api_logout():
    session.clear()
    return jsonify({"ok": True})

# ================= API ADMIN =================
def admin_required(f):
    @wraps(f)
    def wrapper(*args, **kwargs):
        if not session.get("admin"):
            return jsonify({"ok": False, "msg": "Não autorizado."}), 401
        return f(*args, **kwargs)
    return wrapper

@app.route("/api/admin/login", methods=["POST"])
def admin_login():
    d = request.get_json() or {}
    if d.get("senha") == SENHA_ADMIN:
        session["admin"] = True
        return jsonify({"ok": True})
    return jsonify({"ok": False, "msg": "Senha incorreta."}), 401

@app.route("/api/admin/logout", methods=["POST"])
def admin_logout():
    session.pop("admin", None)
    return jsonify({"ok": True})

@app.route("/api/admin/apurar")
@admin_required
def admin_apurar():
    return jsonify({"ok": True, **db.apurar()})

@app.route("/api/admin/status")
@admin_required
def admin_status():
    return jsonify({"ok": True, "encerrada": db.eleicao_encerrada()})

@app.route("/api/admin/encerrar", methods=["POST"])
@admin_required
def admin_encerrar():
    db.set_config("encerrada", "1")
    return jsonify({"ok": True})

@app.route("/api/admin/abrir", methods=["POST"])
@admin_required
def admin_abrir():
    db.set_config("encerrada", "0")
    return jsonify({"ok": True})

@app.route("/api/admin/resetar", methods=["POST"])
@admin_required
def admin_resetar():
    db.resetar_eleicao()
    return jsonify({"ok": True})

@app.route("/api/admin/candidatos", methods=["GET", "POST", "DELETE"])
@admin_required
def admin_candidatos():
    if request.method == "GET":
        return jsonify({"ok": True, "candidatos": db.listar_candidatos()})
    if request.method == "POST":
        d = request.get_json() or {}
        try:
            db.cadastrar_candidato(d["numero"], d["nome"], d.get("chapa",""), d.get("vice",""))
            return jsonify({"ok": True})
        except Exception as e:
            return jsonify({"ok": False, "msg": str(e)}), 400
    d = request.get_json() or {}
    db.remover_candidato(d["numero"])
    return jsonify({"ok": True})

@app.route("/api/admin/alunos", methods=["GET", "POST", "DELETE"])
@admin_required
def admin_alunos():
    if request.method == "GET":
        return jsonify({"ok": True, "alunos": db.listar_alunos()})
    if request.method == "POST":
        d = request.get_json() or {}
        try:
            db.cadastrar_aluno(d["matricula"], d["nome"], d.get("turma",""))
            return jsonify({"ok": True})
        except Exception as e:
            return jsonify({"ok": False, "msg": str(e)}), 400
    d = request.get_json() or {}
    db.remover_aluno(d["matricula"])
    return jsonify({"ok": True})

if __name__ == "__main__":
    app.run(host="0.0.0.0", port=5000, debug=True)
