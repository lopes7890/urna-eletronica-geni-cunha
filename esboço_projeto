```python
import sqlite3
from datetime import datetime

DB = "urna.db"

def conectar():
    conn = sqlite3.connect(DB)
    conn.row_factory = sqlite3.Row
    return conn

def init_db():
    conn = conectar()
    cur = conn.cursor()

    cur.execute("""
        CREATE TABLE IF NOT EXISTS alunos (
            matricula TEXT PRIMARY KEY,
            nome TEXT NOT NULL,
            turma TEXT,
            ja_votou INTEGER DEFAULT 0,
            data_voto TEXT
        )
    """)

    cur.execute("""
        CREATE TABLE IF NOT EXISTS candidatos (
            numero TEXT PRIMARY KEY,
            nome TEXT NOT NULL,
            chapa TEXT,
            vice TEXT
        )
    """)

    cur.execute("""
        CREATE TABLE IF NOT EXISTS votos (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            matricula TEXT NOT NULL,
            numero TEXT,
            tipo TEXT NOT NULL,
            data_hora TEXT NOT NULL
        )
    """)

    cur.execute("""
        CREATE TABLE IF NOT EXISTS config (
            chave TEXT PRIMARY KEY,
            valor TEXT
        )
    """)
    cur.execute("INSERT OR IGNORE INTO config VALUES ('encerrada', '0')")

    cur.execute("SELECT COUNT(*) c FROM candidatos")
    if cur.fetchone()["c"] == 0:
        cur.executemany("INSERT INTO candidatos VALUES (?,?,?,?)", [
            ("10", "Ana Silva", "Juntos Somos Mais", "Pedro Costa"),
            ("20", "Lucas Souza", "Renova Grêmio", "Marina Lima"),
            ("30", "Beatriz Alves", "Voz Estudantil", "Rafael Dias"),
        ])

    cur.execute("SELECT COUNT(*) c FROM alunos")
    if cur.fetchone()["c"] == 0:
        cur.executemany(
            "INSERT INTO alunos (matricula, nome, turma) VALUES (?,?,?)",
            [
                ("2024001", "João Pereira", "3ºA"),
                ("2024002", "Maria Oliveira", "3ºB"),
                ("2024003", "Carlos Santos", "2ºA"),
                ("2024004", "Júlia Costa", "2ºB"),
                ("2024005", "Rafael Lima", "1ºA"),
            ]
        )

    conn.commit()
    conn.close()

# ---------- Config ----------
def get_config(chave):
    conn = conectar()
    r = conn.execute("SELECT valor FROM config WHERE chave=?", (chave,)).fetchone()
    conn.close()
    return r["valor"] if r else None

def set_config(chave, valor):
    conn = conectar()
    conn.execute("INSERT OR REPLACE INTO config VALUES (?,?)", (chave, str(valor)))
    conn.commit()
    conn.close()

def eleicao_encerrada():
    return get_config("encerrada") == "1"

# ---------- Alunos ----------
def buscar_aluno(matricula):
    conn = conectar()
    r = conn.execute("SELECT * FROM alunos WHERE matricula=?", (matricula,)).fetchone()
    conn.close()
    return dict(r) if r else None

def listar_alunos():
    conn = conectar()
    rs = conn.execute("SELECT * FROM alunos ORDER BY matricula").fetchall()
    conn.close()
    return [dict(r) for r in rs]

def cadastrar_aluno(matricula, nome, turma):
    conn = conectar()
    conn.execute("INSERT INTO alunos (matricula, nome, turma) VALUES (?,?,?)",
                 (matricula, nome, turma))
    conn.commit()
    conn.close()

def remover_aluno(matricula):
    conn = conectar()
    conn.execute("DELETE FROM alunos WHERE matricula=?", (matricula,))
    conn.commit()
    conn.close()

# ---------- Candidatos ----------
def listar_candidatos():
    conn = conectar()
    rs = conn.execute("SELECT * FROM candidatos ORDER BY numero").fetchall()
    conn.close()
    return [dict(r) for r in rs]

def cadastrar_candidato(numero, nome, chapa, vice):
    conn = conectar()
    conn.execute("INSERT INTO candidatos VALUES (?,?,?,?)", (numero, nome, chapa, vice))
    conn.commit()
    conn.close()

def remover_candidato(numero):
    conn = conectar()
    conn.execute("DELETE FROM candidatos WHERE numero=?", (numero,))
    conn.commit()
    conn.close()

# ---------- Votos ----------
def registrar_voto(matricula, numero, tipo):
    conn = conectar()
    agora = datetime.now().isoformat(timespec="seconds")
    conn.execute(
        "INSERT INTO votos (matricula, numero, tipo, data_hora) VALUES (?,?,?,?)",
        (matricula, numero, tipo, agora)
    )
    conn.execute(
        "UPDATE alunos SET ja_votou=1, data_voto=? WHERE matricula=?",
        (agora, matricula)
    )
    conn.commit()
    conn.close()

def apurar():
    conn = conectar()
    candidatos = [dict(r) for r in conn.execute(
        "SELECT * FROM candidatos ORDER BY numero").fetchall()]

    votos_validos = {c["numero"]: 0 for c in candidatos}
    for row in conn.execute("SELECT numero FROM votos WHERE tipo='valido'").fetchall():
        if row["numero"] in votos_validos:
            votos_validos[row["numero"]] += 1

    brancos = conn.execute("SELECT COUNT(*) c FROM votos WHERE tipo='branco'").fetchone()["c"]
    nulos = conn.execute("SELECT COUNT(*) c FROM votos WHERE tipo='nulo'").fetchone()["c"]
    total = conn.execute("SELECT COUNT(*) c FROM votos").fetchone()["c"]
    votantes = conn.execute("SELECT COUNT(*) c FROM alunos WHERE ja_votou=1").fetchone()["c"]
    aptos = conn.execute("SELECT COUNT(*) c FROM alunos").fetchone()["c"]
    conn.close()

    resultado = []
    for c in candidatos:
        resultado.append({
            "numero": c["numero"],
            "nome": c["nome"],
            "chapa": c["chapa"],
            "vice": c["vice"],
            "votos": votos_validos[c["numero"]]
        })
    resultado.sort(key=lambda x: x["votos"], reverse=True)
    eleito = resultado[0] if resultado and resultado[0]["votos"] > 0 else None

    return {
        "resultado": resultado,
        "brancos": brancos,
        "nulos": nulos,
        "total_votos": total,
        "votantes": votantes,
        "aptos": aptos,
        "eleito": eleito
    }

def resetar_eleicao():
    conn = conectar()
    conn.execute("DELETE FROM votos")
    conn.execute("UPDATE alunos SET ja_votou=0, data_voto=NULL")
    conn.execute("UPDATE config SET valor='0' WHERE chave='encerrada'")
    conn.commit()
    conn.close()
